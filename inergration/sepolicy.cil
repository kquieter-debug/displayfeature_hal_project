(type displayfeature)
(type displayfeature_exec)
(type displayfeature_service)

(typeattributeset domain (displayfeature))
(typeattributeset exec_type (displayfeature_exec))
(typeattributeset file_type (displayfeature_exec))
(typeattributeset vendor_file_type (displayfeature_exec))
(typeattributeset service_manager_type (displayfeature_service))
(typetransition init displayfeature_exec process displayfeature)
(allow init displayfeature_exec (file (open read getattr execute map)))
(allow init displayfeature (process (transition siginh rlimitinh)))
(allow displayfeature displayfeature_exec (file (entrypoint open read getattr execute map)))
(allow displayfeature self (process (fork sigchld)))
(allow displayfeature servicemanager (binder (call transfer)))
(allow displayfeature displayfeature_service (service_manager (add)))
(allow displayfeature servicemanager (fd (use)))
(allow system_server displayfeature_service (service_manager (find)))
(allow system_server displayfeature (binder (call transfer)))
(allow displayfeature system_server (binder (call transfer)))
(allow displayfeature surfaceflinger (binder (call transfer)))
(allow surfaceflinger displayfeature (binder (call transfer)))
(allow displayfeature self (unix_stream_socket (create read write getattr setattr shutdown)))